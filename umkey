        "Referer": "https://google.com",
        "X-Real-IP": "127.0.0.1",
        "X-Originating-IP": "127.0.0.1",
    }

    # Ejecutar
    print("="*60)
    print("🔒 DETECTOR DE UNKEYED INPUTS (WEB CACHE POISONING)")
    print("="*60)
    print(f"📁 Archivo de entrada: {input_file}")
    print(f"📁 Archivo de salida: {output_file}")
    print(f"🧪 Headers a probar: {len(TEST_HEADERS)}")
    print("-"*60)

    results = process_urls_file(
        input_file,
        TEST_HEADERS,
        output_file=output_file,
        max_workers=3  # Ajusta según necesidad (3-5 es seguro)
    )
