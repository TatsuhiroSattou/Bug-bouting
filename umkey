    if len(sys.argv) < 2:
        print("Uso: python cache_poisoning_detector.py <archivo_urls.txt> [archivo_salida.json]")
        print("\nEjemplo:")
        print("  python cache_poisoning_detector.py urls.txt")
        print("  python cache_poisoning_detector.py urls.txt resultados")
        sys.exit(1)

    input_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else "cache_poisoning_results"

    # Headers a probar (puedes personalizar)
    TEST_HEADERS = {
        "X-Forwarded-For": "127.0.0.1",
        "X-Forwarded-Host": "evil.com",
        "X-Forwarded-Proto": "https",
        "X-Original-URL": "/admin",
